# Copy to .env.local for local development, or set in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- Enquiry email delivery (server-only) ---
# API key from https://resend.com (check its current plan limits against your enquiry volume).
RESEND_API_KEY=
# Sender address on a domain verified in Resend. Add the records Resend shows for the
# domain (DKIM TXT at resend._domainkey, SPF TXT + MX on the "send" subdomain), then verify.
ENQUIRY_FROM_EMAIL="GnF Events Website <enquiries@gnfevents.com.pk>"
# Optional: where enquiries are delivered. Defaults to gnfeventspakistan@gmail.com.
ENQUIRY_TO_EMAIL=

# --- Analytics (public; rendered into the page) ---
# GA4 web data stream measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Analytics cookies are DENIED by default (no consent banner exists yet).
# Set to "granted" only after the business has approved this for its audience.
NEXT_PUBLIC_GA_CONSENT_DEFAULT=

# --- Search engine ownership tags (optional if you verify by DNS instead) ---
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
